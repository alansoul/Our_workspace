{
  "name": "@workspace/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev:workspace": "nx serve workspace",
    "dev:api": "nx serve api",
    "dev:all": "nx run-many --target=serve --all --parallel=3 --output-style=stream",
    "build:all": "nx run-many --target=build --all --parallel=3",
    "test:all": "nx run-many --target=test --all",
    "lint:all": "nx run-many --target=lint --all",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    
    "postinstall": "pnpm prisma:generate",
    "prisma:generate": "npx prisma generate --schema=libs/data-access/prisma/schema.prisma",
    "db:push": "npx prisma db push --schema=libs/data-access/prisma/schema.prisma",
    "db:studio": "npx prisma studio --schema=libs/data-access/prisma/schema.prisma",

    "clean": "nx reset"
  },
  "private": true,
  "dependencies": {
    "next": "~16.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@next/eslint-plugin-next": "^16.1.6",
    "@nx/devkit": "23.2.1",
    "@nx/eslint": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/jest": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/next": "23.2.1",
    "@nx/playwright": "23.2.1",
    "@nx/workspace": "23.2.1",
    "@playwright/test": "^1.37.0",
    "@swc-node/register": "~1.11.1",
    "@swc/cli": "~0.8.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/jest": "~30.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.8.0",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-playwright": "^1.6.2",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "jest": "~30.3.0",
    "jest-environment-jsdom": "~30.3.0",
    "jest-util": "~30.3.0",
    "nx": "23.2.1",
    "prettier": "~3.6.2",
    "ts-jest": "^29.4.7",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0"
  }
}
